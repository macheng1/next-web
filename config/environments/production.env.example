# 本文件不含密钥。个性化配置复制为 production.env（不入库）
DEPLOYMENT_ENV=production
MEMBER_API_URL=https://prd.api.shopai.org.cn/api/v1
# 网站自身地址；生产必须填写实际 HTTPS 域名
NEXT_PUBLIC_SITE_URL=
TRUSTED_ORIGINS=
TRUST_PROXY=false
RATE_LIMIT_MODE=
RATE_LIMIT_VERIFICATION_FILE=

# 本地局域网访问的主机名/IP，逗号分隔；不填写协议或路径
DEV_ALLOWED_ORIGINS=

# Google OAuth 客户端 ID（非密钥）；留空则不显示 Google 授权按钮
GOOGLE_CLIENT_ID=
# 可留空，默认 NEXT_PUBLIC_SITE_URL + /api/auth/google/callback
# 如填写，必须与网站域名及该回调路径一致，并在 Google 控制台登记
GOOGLE_REDIRECT_URI=

# NODE_ENV 由 Next 管理；NEXT_DIST_DIR 由启动命令生成，不在此配置。
# GOOGLE_CLIENT_SECRET 仅配置在 wx-backend，不得放入前端环境。

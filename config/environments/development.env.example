# 本文件不含密钥。个性化配置复制为 development.env（不入库）
DEPLOYMENT_ENV=development
MEMBER_API_URL=https://dev.api.shopai.org.cn/api/v1
# 网站自身地址；生产必须填写实际 HTTPS 域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 新网站只依赖 wx-backend；旧门户启用时才填另一套后端
API_URL=
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_KEY=
TRUSTED_ORIGINS=
TRUST_PROXY=false
RATE_LIMIT_MODE=
RATE_LIMIT_VERIFICATION_FILE=

# 本文件不含密钥。个性化配置复制为 development.env（不入库）
DEPLOYMENT_ENV=development
MEMBER_API_URL=https://dev.api.shopai.org.cn/api/v1
# 网站自身地址；生产必须填写实际 HTTPS 域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TRUSTED_ORIGINS=
TRUST_PROXY=false
RATE_LIMIT_MODE=memory
RATE_LIMIT_VERIFICATION_FILE=

# 本地局域网访问的主机名/IP，逗号分隔；不填写协议或路径
DEV_ALLOWED_ORIGINS=

# Google OAuth 客户端 ID（非密钥）；留空则不显示 Google 授权按钮
GOOGLE_CLIENT_ID=
# 可留空，默认 NEXT_PUBLIC_SITE_URL + /api/auth/google/callback
# 如填写，必须与网站域名及该回调路径一致，并在 Google 控制台登记
GOOGLE_REDIRECT_URI=

# NODE_ENV 由 Next 管理；NEXT_DIST_DIR 由启动命令生成，不在此配置。
# direct 模式密钥在 NestJS；vercel 模式密钥只放 Next.js 服务端，禁止 NEXT_PUBLIC_ 前缀。

# direct 保留旧架构；vercel 在 Next.js 服务端换码验签，两端必须一致
GOOGLE_AUTH_MODE=direct
# 以下只在 vercel 模式填写。Ed25519 PKCS8 私钥，支持真实换行或字面量 \n
GOOGLE_CLIENT_SECRET=
GOOGLE_ASSERTION_PRIVATE_KEY=

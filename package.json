{
  "name": "portal-websits",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:local",
    "build": "npm run build:production",
    "build:verify": "NEXT_DIST_DIR=.next-verify next build",
    "start": "npm run start:production",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "check:production": "tsx scripts/check-production-config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:verify && npm run test:browser",
    "build:local": "tsx scripts/with-environment.ts local build",
    "start:local": "tsx scripts/with-environment.ts local start",
    "check:env:local": "tsx scripts/with-environment.ts local check",
    "dev:local": "tsx scripts/with-environment.ts local dev",
    "build:development": "tsx scripts/with-environment.ts development build",
    "start:development": "tsx scripts/with-environment.ts development start",
    "check:env:development": "tsx scripts/with-environment.ts development check",
    "dev:development": "tsx scripts/with-environment.ts development dev",
    "build:production": "tsx scripts/with-environment.ts production build",
    "start:production": "tsx scripts/with-environment.ts production start",
    "check:env:production": "tsx scripts/with-environment.ts production check"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@douyinfe/semi-icons": "^2.90.10",
    "@douyinfe/semi-ui-19": "^2.90.10",
    "ahooks": "^3.9.6",
    "jose": "^6.1.3",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}

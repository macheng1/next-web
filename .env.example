# 环境变量清单 —— 复制成 .env.local 后按需填写
# 真正的 .env* 都在 .gitignore 里；本文件是唯一的例外（见 .gitignore 末尾的 !.env.example）

# ⚠️ 本项目同时对接两套后端，务必分清，不要互相顶替：
#   门户后端 m-wms-backend（全局前缀 api）
#     @Controller('portal/:domain') → /portal/{domain}/init、/portal/{domain}/products/{id}、/portal/{domain}/inquiry
#     @Controller('upload')         → /upload/public/fileList（官网访客公共附件上传）
#   会员后端 wx-backend（全局前缀 api/v1）
#     /web/auth/*、/web/members/*（注册、登录、改密、会员中心）、/web/files/upload（企业资质上传）

# ── 门户后端（m-wms-backend）─────────────────────────────────────
# API_URL              → BFF：/api/portal/[domain]/inquiry、/api/upload/fileList
# NEXT_PUBLIC_API_URL  → 浏览器侧：src/lib/portal-api.ts 拉门户初始化数据与产品详情
# 本地不启动该服务时，门户页面与询价/附件不可用；会员功能不受影响。
# 注意它默认端口 3000 会与本前端冲突，建议换一个，如：
#   cd ~/Documents/Codex/m-wms-backend && PORT=3100 npm run start:dev
API_URL=http://localhost:3100/api
NEXT_PUBLIC_API_URL=http://localhost:3100/api

# ── 会员后端（wx-backend）───────────────────────────────────────
# 供会员接口使用；不回退到另一套后端。
# 前缀 /api/v1 必须带上（BFF 里是 `${MEMBER_API_URL}/web/...` 直接拼接）。
MEMBER_API_URL=http://localhost:4000/api/v1

# ── 站点自身地址 ────────────────────────────────────────────────
# 用于 robots.ts 拼 sitemap 绝对地址。
# 本地请保持 3000：wx-backend 的 WEB_LOGIN_URL / WEB_RESET_PASSWORD_URL
# 写死了 http://localhost:3000/...，前端换端口会导致邮件里的链接打不开。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 高德地图 ────────────────────────────────────────────────────
# 地图区块（src/components/AmapSection）使用；缺省时该区块不渲染，不影响其余页面。
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_KEY=

# 明确部署环境；生产必须配置 HTTPS 站点及后端
DEPLOYMENT_ENV=development
# 额外可信网站来源，逗号分隔；仅填写 origin，不带路径
TRUSTED_ORIGINS=

# Only enable when the reverse proxy overwrites forwarding headers
TRUST_PROXY=false
# Production mutations require gateway/backend shared protection (verify release checklist)
RATE_LIMIT_MODE=

# Path to externally maintained shared limiter verification evidence (no secrets)
RATE_LIMIT_VERIFICATION_FILE=

# 旧 Next 环境文件入口仅作变量参考。
# 推荐使用 config/environments/{local,development,production}.env.example。
# 个性化配置复制为同目录对应 .env，不入库；运行对应环境命令。
DEPLOYMENT_ENV=local
MEMBER_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 新网站只使用 wx-backend；旧门户另外启用时才配置此地址，禁止填会员后端冒充。
API_URL=
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_KEY=
TRUSTED_ORIGINS=
TRUST_PROXY=false
RATE_LIMIT_MODE=
RATE_LIMIT_VERIFICATION_FILE=
